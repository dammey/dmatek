{
  "font": { "sans": "Manrope", "weights": [400, 500, 600, 700, 800], "mono": "IBM Plex Mono", "monoWeights": [500, 600] },
  "color": {
    "bg": "#F5F1E8", "deep": "#06382E", "mid": "#28705A", "mid2": "#2F7A63",
    "tint": "#EFEADC", "tint2": "#E3DCC8", "ink": "#06382E", "line": "#E6E2D8",
    "gold": "#D4A637", "onGold": "#1A1400",
    "buy": "#C4481C", "onBuy": "#FFFFFF",
    "pass": "#1B7A52", "passOnDark": "#9BE6C5", "warn": "#9A5B00", "fail": "#9E1B32",
    "muted": "#4A5651", "mutedMono": "#5E6E68", "surface": "#FFFFFF"
  },
  "alternatePalettes": {
    "cream-forest-gold": { "buy": "#D4A637", "onBuy": "#1A1400" },
    "forest-orange": { "deep": "#06382E", "mid": "#28705A", "bg": "#FFFFFF", "buy": "#E8590C", "onBuy": "#FFFFFF" },
    "navy-teal-amber": { "deep": "#0B2A4A", "mid": "#1F6F5C", "bg": "#FFFFFF", "buy": "#F4A300", "onBuy": "#1A1200" },
    "dark-green-coral": { "deep": "#0E1F1A", "mid": "#1E8A5E", "bg": "#FFFFFF", "buy": "#FF5A36", "onBuy": "#FFFFFF" },
    "forest-mint-gold": { "deep": "#06382E", "mid": "#28705A", "bg": "#FFFFFF", "buy": "#D4A637", "onBuy": "#1A1400" }
  },
  "type": {
    "display": { "size": "clamp(56px,7vw,104px)", "mobile": "44-52px", "weight": 800, "lineHeight": 0.9, "tracking": "-0.065em" },
    "h2": { "size": "clamp(40px,4.4vw,64px)", "mobile": "34px", "weight": 800, "lineHeight": 0.95, "tracking": "-0.06em" },
    "section": { "size": "clamp(22px,3vw,34px)", "weight": 800, "tracking": "-0.03em" },
    "body": { "size": "15-18px", "weight": 500, "lineHeight": 1.55 },
    "small": { "size": "13-14px", "weight": 600 },
    "label": { "family": "IBM Plex Mono", "size": "11px", "weight": 600, "tracking": "0.12-0.2em", "case": "upper" }
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 18, "xxl": 24, "pill": 99 },
  "shadow": { "sm": "0 2px 8px rgba(0,0,0,.08)", "lift": "0 20px 44px rgba(6,56,46,.14)", "ghost": "0 24px 60px rgba(6,56,46,.25)" },
  "motion": {
    "pageIn": "0.55s cubic-bezier(.2,.7,.2,1), translateY 24px",
    "reveal": "0.8s ease, translateY 30px",
    "heroWipe": "1s cubic-bezier(.7,0,.2,1) clip-path",
    "tileToProduct": "0.7s cubic-bezier(.2,.7,.2,1)",
    "swipe": { "threshold": "min(width*0.28, 300px)", "scale": "1 + |p|*0.35", "rotateX": "|p|*14deg", "overlayFade": "opacity |p|" },
    "heroRotateMs": 3200,
    "reducedMotion": "disable rotation, reveals, parallax and pinned animation (show end state)"
  },
  "frames": { "mobile": 390, "desktopMax": 1600 }
}
