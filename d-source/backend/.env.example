# Supabase project: d-source-backend
SUPABASE_URL=https://yawvfjolibpsvftkgwwt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ass-vB890mFWE7AvIxg6KA_y6Xw9G-5

# Service role key: get from the Supabase dashboard (Project Settings > API).
# Never commit the actual value — server-side use only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

PORT=4000

# CORS: comma-separated list of allowed storefront/admin origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Which card gateway checkout uses. Both adapters exist; this just picks
# which one is active. Leave both secret keys blank to run in sandbox
# mode (orders are created and marked "awaiting confirmation" without an
# actual charge — safe until real merchant accounts exist).
PAYMENT_PROVIDER=paystack

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
