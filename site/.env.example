# Resend (contact form email delivery)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that contact form submissions should be delivered to.
RESEND_TO_EMAIL=

# Extra origins allowed to post enquiries cross-site (comma-separated), e.g.
# a D'Foundry preview host. Any https://*.dmatek.ng origin is always allowed.
ENQUIRY_ALLOWED_ORIGINS=

# Google Analytics 4 measurement ID (G-XXXXXXX). Until set, tracked events
# queue in window.dataLayer and nothing is sent anywhere.
NEXT_PUBLIC_GA_ID=

# Sender shown on notification emails. Defaults to noreply@dmatek.ng, which
# needs dmatek.ng verified in Resend. For testing before that, use
# "D'Matek Website <onboarding@resend.dev>" (delivers only to the Resend
# account owner's own address).
RESEND_FROM=
