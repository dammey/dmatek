# Main D'Matek site: the "← D'MATEK" bar, sister links and the contact
# form's enquiry endpoint (${NEXT_PUBLIC_DMATEK_URL}/api/contact).
NEXT_PUBLIC_DMATEK_URL=https://www.dmatek.ng
NEXT_PUBLIC_SITE_URL=https://foundry.dmatek.ng

# Client names (Droplet / Blessed Water, Omatek, Valour and Valiant) and the
# Droplet case study stay hidden until written permission is in hand.
# Set to "approved" to show them.
NEXT_PUBLIC_FOUNDRY_CLIENT_WORK=

# Google Analytics 4 measurement ID (G-XXXXXXX). Until set, tracked events
# queue in window.dataLayer and nothing is sent anywhere.
NEXT_PUBLIC_GA_ID=
