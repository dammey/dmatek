{
  "name": "dmatek",
  "private": true,
  "workspaces": [
    "site",
    "d-foundry",
    "d-source/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "npm run dev --workspace=site",
    "build:site": "npm run build --workspace=site",
    "dev:foundry": "npm run dev --workspace=d-foundry",
    "build:foundry": "npm run build --workspace=d-foundry",
    "dev:dsource-backend": "npm run dev --workspace=d-source-backend",
    "build:dsource-backend": "npm run build --workspace=d-source-backend",
    "dev:dsource-web": "npm run dev --workspace=d-source-web",
    "build:dsource-web": "npm run build --workspace=d-source-web"
  }
}
